{
  "name": "dsh1024",
  "version": "0.4.2",
  "description": "The 1024 Store for DeepSeek Harness: in-app plugin market and tracked installer CLI.",
  "license": "MIT",
  "homepage": "https://deepseek1024.com/",
  "releaseUrl": "https://deepseek1024.com/plugins/imsai-sh/awesome-deepseek-harness-plugins/packages/dsh1024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsai-sh/awesome-deepseek-harness-plugins.git",
    "directory": "packages/dsh1024"
  },
  "bugs": {
    "url": "https://github.com/imsai-sh/awesome-deepseek-harness-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh1024": "bin/dsh1024.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "cli",
    "client",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js && node --test tests/*.test.mjs && node scripts/preflight.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh1024",
    "dsh-1024store",
    "1024store",
    "1024",
    "plugin",
    "plugin-marketplace",
    "plugins"
  ]
}
