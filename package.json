{
  "name": "dsh-1024store-monorepo",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "homepage": "https://deepseek1024.com/",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "plugin:review": "node scripts/review-plugin-submission.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "readme:build": "node scripts/build-readme.mjs",
    "readme:check": "node scripts/build-readme.mjs --check",
    "test:plugin-review": "node --test scripts/review-plugin-submission.test.mjs",
    "test:plugin-merge": "node --test scripts/merge-plugin-submission.test.mjs",
    "test:submit-skill": "node --test scripts/submit-dsh-plugin-skill.test.mjs",
    "test:catalog-sync": "node --test scripts/sync-catalog.test.mjs",
    "test:readme-build": "node --test scripts/build-readme.test.mjs",
    "test:cli": "npm test --workspace dsh1024",
    "test:api-contract": "npm run test:api-contract --workspace @dsh-1024store/web",
    "dev": "npm run dev --workspace @dsh-1024store/web",
    "build": "npm run build --workspace @dsh-1024store/web && npm run build --workspace dsh1024",
    "typecheck": "npm run typecheck --workspace @dsh-1024store/web && npm run typecheck --workspace dsh1024",
    "test": "npm run test:plugin-review && npm run test:plugin-merge && npm run test:submit-skill && npm run test:catalog-sync && npm run test:readme-build && npm run test:capture-homepage && npm run test:cli && npm run test --workspace @dsh-1024store/web",
    "market:build": "npm run build --workspace dsh1024",
    "market:test": "npm run test --workspace dsh1024",
    "test:visual": "npm run test:visual --workspace @dsh-1024store/web",
    "cf-typegen": "npm run cf-typegen --workspace @dsh-1024store/web",
    "cf-typecheck": "npm run cf-typecheck --workspace @dsh-1024store/web",
    "pack:cli": "npm run pack:check --workspace dsh1024",
    "db:migrate:local": "npm run db:migrate:local --workspace @dsh-1024store/web",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @dsh-1024store/web",
    "predeploy": "npm run build",
    "deploy": "npm run deploy:worker --workspace @dsh-1024store/web",
    "test:capture-homepage": "node --test scripts/capture-homepage.test.mjs",
    "seed:community": "node apps/web/scripts/seed-community.mjs"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
