{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek1024.com/contracts/v1/registry.response.schema.json",
  "type": "object",
  "required": ["name", "updated", "count", "categories", "plugins"],
  "properties": {
    "name": { "const": "dsh-1024store-catalog" },
    "updated": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "label"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer" },
          "label": { "$ref": "https://deepseek1024.com/contracts/catalog.schema.json#/$defs/localizedText" }
        },
        "additionalProperties": true
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "owner", "url", "category", "description", "install", "target", "allowBuild", "added", "stars"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "owner": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://github\\.com/" },
          "category": { "type": "string" },
          "description": { "$ref": "https://deepseek1024.com/contracts/catalog.schema.json#/$defs/localizedText" },
          "install": { "type": "string" },
          "target": { "type": "string" },
          "allowBuild": { "type": ["string", "null"] },
          "added": { "type": "string" },
          "stars": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
